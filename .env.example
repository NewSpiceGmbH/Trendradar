# Kopieren nach .env.local und ausfüllen. Werte lokal: `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Neuer „publishable key“ (sb_publishable_…) oder alter „anon key“
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig! Neuer „secret key“ (sb_secret_…) oder alter „service_role key“
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
