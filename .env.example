# Kopieren nach .env.local und ausfüllen. Werte lokal: `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Neuer „publishable key“ (sb_publishable_…) oder alter „anon key“
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig! Neuer „secret key“ (sb_secret_…) oder alter „service_role key“
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# nur nötig, wenn der API-Schlüssel keinem Workspace zugeordnet ist (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Zeitplan der Scouts (Vercel Cron schickt ihn als Bearer-Token mit) – beliebige lange Zufallszeichenkette
CRON_SECRET=
# Optional: YouTube-Kanäle als Quelle (YouTube Data API v3)
YOUTUBE_API_KEY=

# Demo-Zugänge auf der Login-Seite (nur lokal und in Vorschau-Umgebungen, nie in Produktion).
# Die Konten legt supabase/seed-demo.sql an.
DEMO_LOGIN=
# DEMO_PASSWORD=trendradar-demo

# Testmodus ohne Datenbank: Seed-Daten aus seed/*.json, Demo-Personas per Cookie.
# Für Playwright und Sichtprüfung; auf Vercel wirkungslos.
RADAR_FIXTURES=

# Problem Deep Dive: Notion-Seiten lesen (interne Integration, nur Lesen)
NOTION_TOKEN=

# E-Mail-Versand über Brevo (Bewerbungen, Absagen, Einladungen). Ohne Schlüssel wird nichts verschickt;
# Texte und Links lassen sich dann im Backend kopieren. Absender-Domain bei Brevo mit SPF/DKIM bestätigen.
BREVO_API_KEY=
MAIL_FROM="New Spice Trendradar <trendradar@mail.newspice.de>"
MAIL_REPLY_TO=
# Salz für den Hash der IP-Adresse beim Rate-Limit des Bewerbungsformulars (beliebige lange Zeichenkette)
RATE_LIMIT_SALT=
